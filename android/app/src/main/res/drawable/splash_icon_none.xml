<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 启动画面默认会把 app 图标画在屏幕中央（就是用户看到的「图标界面」）。
     这里给它一张全透明 drawable，配合 windowSplashScreenBackground 纯底色，
     启动时只剩一帧同色背景，直接进 app，不再有 logo 屏。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size
        android:width="1dp"
        android:height="1dp" />
</shape>
