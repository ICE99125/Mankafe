<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 深色模式下的启动画面：同样去掉 app 图标，只留一帧深色底 -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_bg</item>
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_none</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
